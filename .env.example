# CivicPulse API base URL. Include the /api prefix.
NEXT_PUBLIC_API_URL="YOUR_API_URL_HERE"

# Optional quick-login buttons shown on /login.
# Leave a pair blank to hide that role's button.
NEXT_PUBLIC_QUICK_LOGIN_CITIZEN_EMAIL="YOUR_CITIZEN_EMAIL_HERE"
NEXT_PUBLIC_QUICK_LOGIN_CITIZEN_PASSWORD="YOUR_CITIZEN_PASSWORD_HERE"
NEXT_PUBLIC_QUICK_LOGIN_PERSONNEL_EMAIL="YOUR_PERSONNEL_EMAIL_HERE"
NEXT_PUBLIC_QUICK_LOGIN_PERSONNEL_PASSWORD="YOUR_PERSONNEL_PASSWORD_HERE"
NEXT_PUBLIC_QUICK_LOGIN_ADMIN_EMAIL="YOUR_ADMIN_EMAIL_HERE"
NEXT_PUBLIC_QUICK_LOGIN_ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD_HERE"
